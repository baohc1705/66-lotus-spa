{
  "AllowedHosts": "*",
  "ApiSettings": {
    "Name": "66SMS API"
  },
  "ClientAppSettings": {
    "BaseUrl": "http://localhost:5173",
    "ResetPasswordPath": "/reset-password"
  },
  "ConnectionStrings": {
    "SqlServerConn": "Data Source=YOUR_SERVER;Initial Catalog=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;Trust Server Certificate=True;"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "JwtSettings": {
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7,
    "MaxFailedAttempts": 5,
    "Audience": "https://localhost:7777",
    "Issuer": "https://localhost:7777",
    "SecretKey": "YOUR_SECRET_KEY_MIN_32_CHARS"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "LuckyPennySoftware.AutoMapper.License": "None",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MailSettings": {
    "FromEmail": "YOUR_EMAIL",
    "FromName": "66SMS Support",
    "Host": "smtp.gmail.com",
    "Password": "YOUR_EMAIL_PASSWORD",
    "Port": 587,
    "User": "YOUR_EMAIL"
  },
  "OtpSettings": {
    "ExpiryMinutes": 5
  },
  "RabbitMqSettings": {
    "Host": "YOUR_RABBITMQ_HOST",
    "Password": "YOUR_RABBITMQ_PASSWORD",
    "Username": "YOUR_RABBITMQ_USERNAME"
  },
  "RedisSettings": {
    "ConnectionString": "your_redis_connection_string",
    "InstanceName": "your_redis_instance_name:",
    "DefaultTtlMinutes": 30,
    "LoginLimitPerMinute": 10,
    "OtpLimitPerMinute": 5,
    "ForgotPasswordLimitPerMinute": 5,
    "RegisterLimitPerMinute": 5
  },
  "StoredProcedureSettings": {
    "Procedures": {
      "net-revenue": {
        "ProcedureName": "usp_Report_NetRevenue",
        "CacheSeconds": 60,
        "Parameters": [
          { "Name": "@SalonId", "SqlType": "Int", "Source": "query:salonId", "Optional": true },
          { "Name": "@FromDate", "SqlType": "Date", "Source": "query:from", "Optional": false },
          { "Name": "@ToDate", "SqlType": "Date", "Source": "query:to", "Optional": false }
        ]
      },
      "customer-traffic": {
        "ProcedureName": "usp_Report_CustomerTraffic",
        "CacheSeconds": 60,
        "Parameters": [
          { "Name": "@SalonId", "SqlType": "Int", "Source": "query:salonId", "Optional": true },
          { "Name": "@Granularity", "SqlType": "NVarChar", "Source": "query:tab", "Optional": false },
          { "Name": "@FromDate", "SqlType": "Date", "Source": "query:from", "Optional": false },
          { "Name": "@ToDate", "SqlType": "Date", "Source": "query:to", "Optional": false }
        ]
      }
    }
  },
  "BackgroundJobSettings": {
    "CleanupRevokedRefreshTokens": {
      "IntervalMinutes": 30
    }
  },
  "VnPaySettings": {
    "HashSecret": "YOUR_HASH_SECRET",
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:5173/thanh-toan/vnpay-return",
    "TmnCode": "YOUR_TMN_CODE"
  }
}